<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="mb-root" class="mb-root">
        <ui:Label name="mb-menu" class="mb-menu" text="..." tooltip="Menu" />
        <ui:VisualElement name="mb-core" class="mb-core" picking-mode="Ignore">
            <ui:Label name="mb-kicker" class="mb-kicker" text="MATRIX BRIDGE" picking-mode="Ignore" />
            <ui:Label name="mb-state" class="mb-state mb-state--offline" text="OFFLINE" tooltip="Link or unlink the bridge" />
            <ui:Label name="mb-address" class="mb-address" text="" />
            <ui:Label name="mb-note" class="mb-note" text="" picking-mode="Ignore" />
            <ui:Label name="mb-lock" class="mb-lock" text="" />
        </ui:VisualElement>
        <ui:VisualElement name="mb-chips" class="mb-chips" />
    </ui:VisualElement>
</ui:UXML>
