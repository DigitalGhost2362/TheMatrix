<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="sk-row">
        <ui:VisualElement class="sk-row__body">
            <ui:VisualElement class="sk-row__head">
                <ui:Label name="sk-row-title" class="sk-row__title" />
                <ui:Label name="sk-row-id" class="sk-tag sk-tag--id sk-mono" />
                <ui:Label name="sk-row-core" text="core" class="sk-tag sk-tag--core sk-mono" />
                <ui:Label name="sk-row-risk" class="sk-tag sk-mono" />
            </ui:VisualElement>
            <ui:Label name="sk-row-desc" class="sk-row__desc" />
            <ui:VisualElement name="sk-row-hint" class="sk-row__hint" />
        </ui:VisualElement>
        <ui:Label name="sk-row-cost" class="sk-row__cost sk-mono" />
        <ui:Toggle name="sk-row-toggle" class="sk-sw" />
    </ui:VisualElement>
</ui:UXML>
