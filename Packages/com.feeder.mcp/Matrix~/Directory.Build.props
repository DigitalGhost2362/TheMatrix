<Project>
  <PropertyGroup>
    <!-- .NET 10 LTS per ADR-0001. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Keeps the build machine's folders out of the shipped binaries (source and pdb paths). -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <PathMap Condition="'$(ArtifactsPath)' != ''">$(PathMap),$([System.IO.Path]::GetFullPath('$(ArtifactsPath)'))=/_artifacts/</PathMap>
  </PropertyGroup>
</Project>
