# This repository is the com.feeder.mcp UPM package itself. Unity projects embed it under
# Packages/com.feeder.mcp or install it from the Git URL, so only package files are tracked.

# IDE and build output
.vs/
.idea/
.vscode/
.cursor/
*.csproj
!Matrix~/**/*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp
*.log
sysinfo.txt

# Development-only notes and helpers
/docs/
/PLAN-*.md
/MatrixWatch/
/TestCases/
/Documentation~/_build/mshot.py

# Secrets and signing material must never be committed
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
**/.claude/settings.local.json
